<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clara</groupId>
        <artifactId>clara-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>clara-sdk</artifactId>
    <name>Clara :: SDK</name>
    <description>可嵌入宿主服务的 Agent 客户端库，不包含 CLI 依赖。</description>

    <dependencies>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-orchestration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-skill</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- 中文工作目录名转写为 ASCII，供 Milvus 集合命名；仅 SDK 引入，CLI 通过 SDK 传递使用。 -->
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
