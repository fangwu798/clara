<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clara</groupId>
        <artifactId>clara-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>clara-application</artifactId>
    <name>Clara :: Application</name>
    <dependencies>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- POI 经 Log4j2 API 打日志；桥接到 SLF4J（再经 slf4j-nop 静默），消除启动告警。 -->
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <!-- 读取 config/clara.yml 的嵌套配置（如 milvus 语义记忆节点）。 -->
        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
        <dependency><groupId>junit</groupId><artifactId>junit</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-orchestration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-skill</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 汉字转拼音：工作目录名为中文时转写为 ASCII 项目名（供 Milvus 集合命名）。 -->
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
        </dependency>
        <!-- 控制台单键 ESC 监听（执行中取消本轮模型调用与工具执行）。 -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jna</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 打成可直接 `java -jar` 运行的可执行 fat jar，输出到仓库根目录 clara.jar。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 不生成 dependency-reduced-pom.xml（模块 artifact 保持原样，仅额外产出 fat jar） -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <outputFile>${project.basedir}/../clara.jar</outputFile>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- 去除签名文件，避免运行期 Invalid signature -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.clara.ClaraApplication</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!--
        覆盖率门禁（可选）：mvn -B verify -Pcoverage-gate。
        汇总各模块 target/site/jacoco/jacoco.xml，整体行覆盖率低于 80% 时构建失败。
    -->
    <profiles>
        <profile>
            <id>coverage-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.0.0</version>
                        <executions>
                            <execution>
                                <id>check-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>node</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>tools/coverage/check-coverage.mjs</argument>
                                        <argument>0.80</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
