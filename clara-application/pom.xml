<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clara</groupId>
        <artifactId>clara-parent</artifactId>
        <version>1.0.1</version>
    </parent>
    <artifactId>clara-application</artifactId>
    <name>Clara :: CLI</name>
    <properties>
        <!-- 可执行 CLI 不作为依赖发布：只发布库模块到 Maven 仓库。 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencies>
        <!-- 嵌入能力全部来自 SDK；本模块只保留 CLI 外壳。 -->
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 可选语义记忆后端：CLI 打包时带上，宿主嵌入 SDK 时按需自行引入。 -->
        <dependency>
            <groupId>com.clara</groupId>
            <artifactId>clara-memory-milvus</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- CLI 专用的终端依赖，不应传递给 SDK 使用方。 -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-reader</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jna</artifactId>
        </dependency>
        <!-- 只有可执行 CLI 需要静默第三方日志；库使用方自行选择 SLF4J binding。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 覆盖率统计排除交互式入口与 JLine 平台补丁类：前者需要真实终端与模型，
                 由手动冒烟覆盖；后者的分支取决于终端实现，单测无法稳定驱动。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/clara/ClaraApplication*</exclude>
                        <exclude>org/jline/terminal/impl/jna/win/ClaraWinSysTerminal*</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 打成可直接 `java -jar` 运行的可执行 fat jar，输出到仓库根目录 clara.jar。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 不生成 dependency-reduced-pom.xml（模块 artifact 保持原样，仅额外产出 fat jar） -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <outputFile>${project.basedir}/../clara.jar</outputFile>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- 去除签名文件，避免运行期 Invalid signature -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.clara.ClaraApplication</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!--
        覆盖率门禁（可选）：mvn -B verify -Pcoverage-gate。
        汇总各模块 target/site/jacoco/jacoco.xml，整体行覆盖率低于 80% 时构建失败。
    -->
    <profiles>
        <profile>
            <id>coverage-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.0.0</version>
                        <executions>
                            <execution>
                                <id>check-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>node</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>deploy/coverage/check-coverage.mjs</argument>
                                        <argument>0.80</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
