<?xml version="1.0" encoding="UTF-8"?>
<!--
  clara-sample：能力联调与验证工程。
  独立 Maven 工程，不纳入根 pom 的 <modules>，按需运行。
  运行前置：先在仓库根目录执行 `mvn -q install -DskipTests` 把 clara-* 发布到本地仓库；
  随后在**仓库根目录**执行 `mvn -f sample/pom.xml compile exec:java`（工作目录须为仓库根，config/ 才可被定位）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.clara</groupId>
    <artifactId>clara-sample</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Clara :: Sample</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <clara.version>0.1.0-SNAPSHOT</clara.version>
        <jackson.version>2.13.4</jackson.version>
        <exec.plugin.version>3.1.0</exec.plugin.version>
    </properties>

    <dependencies>
        <dependency><groupId>com.clara</groupId><artifactId>clara-application</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-core</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-model</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-memory</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-skill</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-workflow</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-orchestration</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.clara</groupId><artifactId>clara-mcp</artifactId><version>${clara.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson.version}</version></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <mainClass>com.clara.sample.SampleApplication</mainClass>
                    <classpathScope>runtime</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
