target/
**/target/
.idea/
*.iml
.clara/
.m2/
/output/

# 本地 docker compose 部署（Milvus 等）产生的运行数据：etcd / minio / milvus，不纳入版本控制。
/deploy/volumes/

# codebase-memory-mcp 容器部署：构建上下文（官方产物）与本地 .env 都不入库。
/deploy/codebase-memory-mcp/.build/
/deploy/codebase-memory-mcp/.env

# sample 联调运行产物（file_ops 工具写入的工作区输出目录）。
/config/sample/workspace/notes/

# 根目录下的可执行 fat jar 构建产物。
/clara.jar

# 运行期详细日志（交互入口写入，仅本地保留）。
/logs/
/output/

# 本机模型平台配置可能包含真实地址和密钥，只提交 examples 与说明文件。
/config/model-providers/local/*.yml
/config/model-providers/local/*.yaml

# 本机 MCP 服务端配置可能包含真实密钥，仅本地保留，不提交。
/config/mcp/mcp.json

# JVM 崩溃产物（HotSpot error / replay 文件）。
replay_pid*.log
hs_err_pid*.log

# Python 字节码缓存（手工执行 config/skill/scripts 下的脚本时会生成，框架执行时已禁用）。
__pycache__/

# 按需挂载生成的 compose 覆盖文件（ensure-mount.ps1 写，内容随本机挂了哪些工作目录变化）。
/deploy/docker-compose.mounts.yml

# 本地调试产物（临时日志、探针脚本、截图等），不入库。
/.local/

# 开发过程文档（架构、业务、技术设计与迁移记录等）仅保留在本地，不纳入版本库。
/docs/
