target/
**/target/
.idea/
*.iml
.clara/
.m2/
/output/

# 本地 docker compose 部署（Milvus 等）产生的运行数据：etcd / minio / milvus，不纳入版本控制。
/deploy/volumes/

# sample 联调运行产物（file_ops 工具写入的工作区输出目录）。
/config/sample/workspace/notes/

# 根目录下的可执行 fat jar 构建产物。
/clara.jar

# 运行期详细日志（交互入口写入，仅本地保留）。
/logs/

# 本机模型平台配置可能包含真实地址和密钥，只提交 examples 与说明文件。
/config/model-providers/local/*.yml
/config/model-providers/local/*.yaml

# 本机 MCP 服务端配置可能包含真实密钥，仅本地保留，不提交。
/config/mcp/mcp.json

# JVM 崩溃产物（HotSpot error / replay 文件）。
replay_pid*.log
hs_err_pid*.log

# Python 字节码缓存（手工执行 config/skill/scripts 下的脚本时会生成，框架执行时已禁用）。
__pycache__/
